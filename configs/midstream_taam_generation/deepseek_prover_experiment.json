{
  "name": "deepseek_prover_from_lean_trace",
  "graph_json": "",
  "lean_trace_json": "configs/lean_trace_demo.json",
  "out_dir": "artifacts/midstream_taam_generation/deepseek_prover_single",
  "capability_threshold": 0.0,
  "seed": 7,
  "solver_type": "deepseek_prover",
  "solver_config": {
    "command_template": "python tools/run_deepseek_prover.py --lean-file \"{lean_file}\" --out-json \"{result_json}\" --model-id \"deepseek-ai/DeepSeek-Prover-V2-7B\" --device-map \"auto\" --torch-dtype \"auto\" --load-in-4bit --bnb-4bit-compute-dtype \"float16\" --bnb-4bit-quant-type \"nf4\" --bnb-4bit-use-double-quant --max-new-tokens 512 --validator-project-root \"lean_project\"",
    "timeout_sec": 120
  },
  "validation_config": {
    "enabled": true,
    "command_template": "python tools/run_lean_validator.py --lean-file \"{lean_file}\" --out-json \"{result_json}\" --project-root \"lean_project\"",
    "timeout_sec": 120
  },
  "masking_strategy": "greedy_topology",
  "masking_config": {
    "seed": 7
  }
}
